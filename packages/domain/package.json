{
  "name": "@odin/domain",
  "version": "0.2.0",
  "description": "L1 Domain Layer — Entities, Repositories, and Domain Events (DDD)",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./entities": "./entities/index.ts",
    "./entities/existence": "./entities/existence/index.ts",
    "./entities/identity": "./entities/identity/index.ts",
    "./entities/commercial": "./entities/commercial/index.ts",
    "./entities/operational": "./entities/operational/index.ts",
    "./entities/temporal": "./entities/temporal/index.ts",
    "./entities/integration": "./entities/integration/index.ts",
    "./entities/process-mining": "./entities/process-mining/index.ts",
    "./entities/analytics": "./entities/analytics/index.ts",
    "./entities/studio": "./entities/studio/index.ts",
    "./entities/automation": "./entities/automation/index.ts",
    "./repositories": "./repositories/index.ts",
    "./repositories/existence": "./repositories/existence/index.ts",
    "./repositories/identity": "./repositories/identity/index.ts",
    "./repositories/commercial": "./repositories/commercial/index.ts",
    "./repositories/operational": "./repositories/operational/index.ts",
    "./repositories/temporal": "./repositories/temporal/index.ts",
    "./repositories/integration": "./repositories/integration/index.ts",
    "./repositories/process-mining": "./repositories/process-mining/index.ts",
    "./repositories/analytics": "./repositories/analytics/index.ts",
    "./repositories/studio": "./repositories/studio/index.ts",
    "./repositories/automation": "./repositories/automation/index.ts",
    "./events": "./events/index.ts"
  },
  "files": [
    "**/*.ts",
    "!**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "domain",
    "ddd",
    "domain-driven-design",
    "entities",
    "repositories",
    "aggregate",
    "value-object",
    "domain-events"
  ],
  "license": "MIT",
  "dependencies": {
    "@odin/core-contracts": "workspace:*",
    "@odin/core-lib": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}

